# Doxyfile — Modeler project documentation
# Run: doxygen docs/Doxyfile  (from repo root)
# Output: docs/html/

PROJECT_NAME           = "Modeler"
PROJECT_NUMBER         = 0.1.0
PROJECT_BRIEF          = "Cross-platform 3D CAD modeller"

OUTPUT_DIRECTORY       = docs

# ── Input ─────────────────────────────────────────────────────────────────────
INPUT                  = include src README.md
INPUT_ENCODING         = UTF-8
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.hpp *.cpp *.md
EXCLUDE_PATTERNS       = */build/* */tests/*
USE_MDFILE_AS_MAINPAGE = README.md

# ── Extraction ────────────────────────────────────────────────────────────────
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = YES
HIDE_UNDOC_CLASSES     = YES
INTERNAL_DOCS          = NO
JAVADOC_AUTOBRIEF      = YES

# ── Output formats ────────────────────────────────────────────────────────────
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HTML_OUTPUT            = html
HTML_COLORSTYLE        = DARK

# ── Diagrams (requires Graphviz) ──────────────────────────────────────────────
HAVE_DOT               = YES
DOT_NUM_THREADS        = 4
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
UML_LOOK               = YES
UML_LIMIT_NUM_FIELDS   = 10
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES

# ── Source browser ────────────────────────────────────────────────────────────
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO

# ── Warnings ──────────────────────────────────────────────────────────────────
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
